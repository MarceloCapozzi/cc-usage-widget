{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cc-usage",
  "identifier": "ar.cc.usage",
  "build": {
    "frontendDist": "ui",
    "beforeBuildCommand": {
      "script": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/stage-cc-hook.ps1",
      "cwd": ".."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "flyout",
        "title": "cc-usage",
        "width": 436,
        "height": 560,
        "minWidth": 360,
        "minHeight": 220,
        "maxWidth": 900,
        "maxHeight": 1000,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Marcelo Capozzi",
    "copyright": "Copyright (c) 2026 Marcelo Capozzi",
    "shortDescription": "Claude Code usage and sessions in the Windows tray",
    "longDescription": "Shows Claude session and weekly limits, per-model sub-limits, the context window and the state of every Claude Code session, without opening a browser.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "resources": {
      "staging/cc-hook.exe": "cc-hook.exe"
    }
  }
}
