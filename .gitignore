# Secrets: the Synadia API token, NATS credentials and seeds, the envelope
# key, and publisher bundles (they hold creds and the key).
.env
.env.*
!.env.example
*.creds
*.nk
# Code-signing material and local Claude Code settings of this checkout.
*.pfx
*.p12
.claude/settings.local.json
CLAUDE.local.md
/key
*.key
secrets/
cc-usage-publisher-*/
*.pem
# Public keys of one installation (a viewer's viewer.pub copied for
# -ViewerPub, pinned publisher keys): public, but not the repository's.
/pub/
*.pub
# The NATS project file of one deployment: it lists the real machine
# aliases. The repository keeps infra/nats/cc-sessions.example.yaml.
/infra/nats/cc-sessions.yaml
# Backups left by scripts and editors.
*.bak
*.bak-*
# Screenshots taken from real sessions; docs use --demo captures only.
/docs/screenshots/remote*.png
# The maintainer's build log and its old screenshots: local only.
/docs/history/
# Settings → Data backups: usage, project names and maybe sealed keys.
*.ccbak
*.tar.gz
*.zip

# Machine-specific build settings (copy .cargo/config.example.toml).
.cargo/config.toml

# Build output
target/
node_modules/
dist/

# Generated by tauri-build on every build
app/gen/schemas/

# cc-hook.exe staged for the installer by tools/stage-cc-hook.ps1
app/staging/

# Diagnostics written to the current folder (see docs/development.md)
*.log
sessions.txt

# OS and editor files
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
